// KH PAX Viewer's icon and version (PAX_VERSION_* come from CMakeLists.txt's project version).
#include <winver.h>

1 ICON "icon.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION PAX_VERSION_MAJOR, PAX_VERSION_MINOR, PAX_VERSION_PATCH, 0
PRODUCTVERSION PAX_VERSION_MAJOR, PAX_VERSION_MINOR, PAX_VERSION_PATCH, 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "KH PAX Viewer"
            VALUE "ProductName", "KH PAX Viewer"
            VALUE "FileVersion", PAX_VERSION_STRING
            VALUE "ProductVersion", PAX_VERSION_STRING
            VALUE "OriginalFilename", "KH PAX Viewer.exe"
            VALUE "LegalCopyright", "MIT License, Yokimitsuro and contributors"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
